# Default Jellyfin server address (no trailing slash), e.g. http://192.168.1.10:8096.
# A Jellyfin admin can change it later in Settings -> Server; this value is what it falls back to.
JELLYFIN_URL=http://your-jellyfin-host:8096

# 32+ char random secret used to encrypt the session cookie.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional: poster width in px for every poster (rows, library grid, collections).
# Default 215 (about the size of Jellyfin web). Allowed 120-400.
# Build-time value: restart `next dev` (or re-run `next build` for production) after changing.
# With Docker it only applies if you build the image yourself (`docker compose up -d --build`);
# the prebuilt ghcr.io image always uses 215.
NEXT_PUBLIC_POSTER_WIDTH=215

# Where Jelly Shark keeps its SQLite database (per-user settings).
# Default ./data/jelly-shark.db; the container uses /data/jelly-shark.db (mount a volume there).
# DATABASE_PATH=./data/jelly-shark.db
