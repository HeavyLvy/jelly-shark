# syntax=docker/dockerfile:1

# ---- install dependencies (cached until package*.json change) ----
FROM node:24-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# better-sqlite3 ships prebuilt binaries inside the package; skipping install scripts avoids a source build.
RUN npm ci --no-audit --no-fund --ignore-scripts

# ---- build ----
FROM node:24-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# NEXT_PUBLIC_* values are baked into the browser bundle at build time.
ARG NEXT_PUBLIC_POSTER_WIDTH
ENV NEXT_PUBLIC_POSTER_WIDTH=$NEXT_PUBLIC_POSTER_WIDTH \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ---- runtime: just the standalone server ----
FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    DATABASE_PATH=/data/jelly-shark.db
# The SQLite database lives on a volume so settings survive upgrades.
RUN mkdir -p /data && chown node:node /data
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
# License and third-party notices travel with the image.
COPY --chown=node:node LICENSE NOTICE ./
# Database migrations (generated by drizzle-kit), applied at startup.
COPY --from=build --chown=node:node /app/drizzle ./drizzle
USER node
VOLUME /data
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/api/health >/dev/null || exit 1
CMD ["node", "server.js"]
