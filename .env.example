# Jellyfin server base URL (no trailing slash), e.g. http://192.168.1.10:8096
JELLYFIN_URL=http://your-jellyfin-host:8096

# 32+ char random secret used to encrypt the session cookie.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional: poster width in px for every poster (rows, library grid, collections).
# Default 215 (about the size of Jellyfin web). Allowed 120-400.
# Build-time value: restart `next dev` (or re-run `next build` for production) after changing.
NEXT_PUBLIC_POSTER_WIDTH=215
